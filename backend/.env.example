APP_ENV=dev
LOG_LEVEL=INFO
SERVICE_NAME=condo-management-api

ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SECRET_KEY=change-me-in-local-dev-only
DATABASE_URL=postgresql+asyncpg://postgres:devpassword@db:5432/condo_dev
# Test suite only: dropped and rebuilt on every run; the name must end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:devpassword@127.0.0.1:5432/condo_test
READINESS_CHECK_DATABASE=true

AWS_REGION=ca-central-1
S3_BUCKET_NAME=condo-app-dev-files
# Local S3 emulator only (ADR-0007): unset both in production.
S3_ENDPOINT_URL=http://s3:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
SES_FROM_EMAIL=noreply@example.com

# Mailpit locally (UI: http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025

GIT_SHA=local
IMAGE_TAG=local
BUILD_TIME=local
