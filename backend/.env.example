# dev | test | staging | prod. staging and prod reject the dev defaults below.
APP_ENV=dev
LOG_LEVEL=INFO
SERVICE_NAME=condo-management-api

# Origins the app is served from; the CSRF check (P2-01) trusts only these. Same-origin: no CORS.
TRUSTED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SECRET_KEY=change-me-in-local-dev-only
DATABASE_URL=postgresql+asyncpg://postgres:devpassword@db:5432/condo_dev
# Test suite only: each run builds and drops its own copy (<stem>_run_<pid>_<hex>_test); must end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:devpassword@127.0.0.1:5432/condo_test
READINESS_CHECK_DATABASE=true
# Serve /api/docs and /api/openapi.json (open without a session). Default: true in dev/test, false in staging/prod.
# API_DOCS_ENABLED=false
# Staging only, a secret: the seeded demo users' password there (`seed` refuses without it). Dev and test
# always use the public DevPassword!2026.
# SEED_PASSWORD=

# Sessions (ADR-0003). The cookie defaults to `session` (no Secure) in dev/test and `__Host-session` with Secure
# in staging/prod, which refuse anything else. Lifetimes: absolute days, idle days (residents), idle hours (staff).
# SESSION_COOKIE_NAME=session
# SESSION_COOKIE_SECURE=false
# SESSION_ABSOLUTE_DAYS=30
# SESSION_IDLE_RESIDENT_DAYS=7
# SESSION_IDLE_STAFF_HOURS=12

# Rate limits (P2-05): JSON {"limit", "window_seconds"}, window at most 86400. Defaults shown.
# RATE_LIMIT_LOGIN_IP={"limit": 30, "window_seconds": 600}
# RATE_LIMIT_LOGIN_EMAIL={"limit": 8, "window_seconds": 900}
# RATE_LIMIT_RESET_IP={"limit": 30, "window_seconds": 600}
# RATE_LIMIT_RESET_EMAIL={"limit": 8, "window_seconds": 900}
# RATE_LIMIT_SIGNUP_IP={"limit": 10, "window_seconds": 3600}
# RATE_LIMIT_JOIN_IP={"limit": 20, "window_seconds": 600}

AWS_REGION=ca-central-1
S3_BUCKET_NAME=condo-app-dev-files
# Local S3 emulator only (ADR-0007): unset both in production.
S3_ENDPOINT_URL=http://s3:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
SES_FROM_EMAIL=noreply@example.com

# Mailpit locally (UI: http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025

GIT_SHA=local
IMAGE_TAG=local
BUILD_TIME=local
